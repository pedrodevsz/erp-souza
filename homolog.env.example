# Copie para .env.homolog.local e mantenha o arquivo local fora do Git.
APP_ENV=homologation
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/erp_souza_homolog?retryWrites=true&w=majority
AUTH_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=replace-with-supported-model-name

# Defina somente depois de confirmar que o database e exclusivo de homologacao.
HOMOLOGATION_DATABASE_CONFIRMED=erp_souza_homolog
HOMOLOG_ADMIN_USERNAME=replace-with-homologation-admin
HOMOLOG_ADMIN_PASSWORD=replace-with-a-strong-homologation-password
HOMOLOGATION_BASE_URL=https://erp-souza.local:8443
