# Copie para .env.production.local e mantenha o arquivo fora do Git.
# MONGODB_URI e AUTH_SECRET sao obrigatorios para o ERP.

# Database de producao explicitamente definido. Codifique caracteres reservados
# da senha de acordo com a sintaxe de URI MongoDB.
MONGODB_URI='mongodb+srv://<usuario>:<senha-percent-encoded>@<cluster>.mongodb.net/erpSouza?retryWrites=true&w=majority'
AUTH_SECRET=replace-with-a-unique-production-secret

# Opcionais; usados apenas na importacao assistida de notas fiscais.
# OPENAI_API_KEY='replace-with-production-api-key'
# OPENAI_MODEL='gpt-4.1-mini'
